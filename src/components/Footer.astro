---
import "../styles/footer.css";
import { siteContact } from "../data/site";
import { footerBrand } from "../data/footer";
---

<footer class="footer">
  <div class="footer-inner">
    <span class="footer-brand">{footerBrand}</span>
    <span class="footer-addr">{siteContact.address}</span>
    <span class="footer-id">{siteContact.email} · {siteContact.phoneShort}</span>
  </div>
</footer>
