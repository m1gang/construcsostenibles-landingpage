---
import "../styles/contacto.css";
import ContactInfo from "./contacto/ContactInfo.astro";
import ContactForm from "./contacto/ContactForm.astro";
---

<section class="contacto section" id="contacto">
  <div class="container">
    <div class="rule-label">
      <span class="tag">
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <rect
            x="2"
            y="3"
            width="12"
            height="10"
            rx="1"
            stroke="currentColor"
            stroke-width="1.2"></rect>
          <polyline
            points="2,3 8,9 14,3"
            stroke="currentColor"
            stroke-width="1.2"
            fill="none"></polyline>
        </svg>
        CONTACTO
      </span>
    </div>

    <div class="contact-grid">
      <ContactInfo />

      <div class="contact-form-card">
        <ContactForm />
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/contacto";
</script>
