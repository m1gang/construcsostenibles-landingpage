---
interface Props {
	phone?: string;
}

const { phone = '929 057 970' } = Astro.props;
const tel = 'tel:+51' + phone.replace(/\s/g, '');

const links = [
	{ href: '#servicios', label: 'Servicios' },
	{ href: '#equipo', label: 'Equipo' },
	{ href: '#proceso', label: 'Proceso' },
	{ href: '#proyectos', label: 'Proyectos' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="masthead" id="inicio">
	<div class="masthead-inner">
		<a class="brand" href="#inicio" aria-label="Construcciones Sostenibles — inicio">
			<img src="/isotipo.png" alt="" width="44" height="44" />
			<span class="brand-name">
				Construcciones <br /><strong>Sostenibles</strong>
			</span>
		</a>

		<nav class="nav" aria-label="Navegación principal">
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>

		<a class="phone" href={tel}>
			<span class="tag">Línea directa</span>
			<span class="phone-num">{phone}</span>
		</a>

		<button class="hamburger" id="navToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileNav">
			<span></span><span></span><span></span>
		</button>
	</div>
</header>

<div class="mobile-nav" id="mobileNav" aria-hidden="true">
	<div class="mobile-nav-head">
		<span class="tag">ÍNDICE DE LÁMINA</span>
		<button class="mobile-close" id="navClose" aria-label="Cerrar menú">
			<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1 L13 13 M13 1 L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
		</button>
	</div>
	<nav class="mobile-nav-links" aria-label="Navegación móvil">
		{links.map((l, i) => (
			<a href={l.href} class="mobile-link" style={`--i:${i}`}>
				<span class="ml-num">0{i + 1}</span>
				<span class="ml-label">{l.label}</span>
				<span class="ml-arrow" aria-hidden="true">→</span>
			</a>
		))}
	</nav>
	<div class="mobile-nav-foot">
		<a href={tel} class="mobile-phone">{phone}</a>
		<span class="tag">SMP · LIMA · PERÚ</span>
	</div>
</div>

<style>
	.masthead {
		border-bottom: 1px solid var(--ink);
		background: color-mix(in srgb, var(--sheet) 88%, transparent);
		backdrop-filter: blur(6px);
		position: sticky;
		top: 0;
		z-index: 60;
	}

	.masthead-inner {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2.5rem);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: stretch;
		gap: clamp(1rem, 3vw, 2.5rem);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 0;
		text-decoration: none;
	}

	.brand img {
		width: 42px;
		height: 42px;
		object-fit: contain;
	}

	.brand-name {
		font-stretch: 112%;
		font-weight: 500;
		font-size: 0.8125rem;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.brand-name strong {
		font-weight: 800;
	}

	.nav {
		display: flex;
		align-items: stretch;
		justify-content: center;
	}

	.nav a {
		display: flex;
		align-items: center;
		padding: 0 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-2);
		border-left: 1px solid var(--line-soft);
		position: relative;
		transition: color 200ms var(--ease-out-expo);
	}

	.nav a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--green);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 250ms var(--ease-out-expo);
	}

	.nav a:last-child {
		border-right: 1px solid var(--line-soft);
	}

	.nav a:hover {
		color: var(--green-deep);
	}

	.nav a:hover::after {
		transform: scaleX(1);
	}

	.phone {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.1rem;
		text-decoration: none;
		text-align: right;
		padding: 0.4rem 0;
	}

	.phone-num {
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--ink);
	}

	.phone:hover .phone-num {
		color: var(--green-deep);
	}

	/* ---- hamburguesa ---- */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: 1px solid var(--line);
		width: 44px;
		height: 44px;
		padding: 0 10px;
		cursor: pointer;
		align-self: center;
	}

	.hamburger span {
		display: block;
		height: 1.5px;
		background: var(--ink);
		transition: transform 250ms var(--ease-out-expo), opacity 200ms;
	}

	.hamburger[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}
	.hamburger[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}
	.hamburger[aria-expanded='true'] span:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}

	/* ---- nav móvil ---- */
	.mobile-nav {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: var(--paper);
		background-image:
			linear-gradient(to right, var(--grid) 1px, transparent 1px),
			linear-gradient(to bottom, var(--grid) 1px, transparent 1px),
			linear-gradient(to right, var(--grid-strong) 1px, transparent 1px),
			linear-gradient(to bottom, var(--grid-strong) 1px, transparent 1px);
		background-size: 28px 28px, 28px 28px, 140px 140px, 140px 140px;
		display: flex;
		flex-direction: column;
		padding: 1.2rem;
		clip-path: inset(0 0 100% 0);
		transition: clip-path 500ms var(--ease-out-expo);
		visibility: hidden;
	}

	.mobile-nav.open {
		clip-path: inset(0 0 0 0);
		visibility: visible;
	}

	.mobile-nav-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--ink);
	}

	.mobile-close {
		background: none;
		border: 1px solid var(--line);
		width: 42px;
		height: 42px;
		font-size: 1rem;
		color: var(--ink);
		cursor: pointer;
	}

	.mobile-nav-links {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2rem;
	}

	.mobile-link {
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		align-items: center;
		padding: 0.9rem 0.4rem;
		text-decoration: none;
		border-bottom: 1px solid var(--line);
		opacity: 0;
		transform: translateY(14px);
	}

	.mobile-nav.open .mobile-link {
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 400ms var(--ease-out-expo) calc(var(--i) * 60ms + 200ms),
			transform 400ms var(--ease-out-expo) calc(var(--i) * 60ms + 200ms);
	}

	.ml-num {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--ink-3);
	}

	.ml-label {
		font-stretch: 112%;
		font-size: 1.6rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.ml-arrow {
		font-size: 1.2rem;
		color: var(--green-deep);
		transition: transform 200ms var(--ease-out-expo);
	}

	.mobile-link:hover .ml-arrow {
		transform: translateX(6px);
	}

	.mobile-nav-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1rem;
		border-top: 1px solid var(--ink);
	}

	.mobile-phone {
		font-family: var(--font-mono);
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--green-deep);
		text-decoration: none;
	}

	@media (max-width: 54rem) {
		.nav,
		.phone {
			display: none;
		}
		.masthead-inner {
			grid-template-columns: auto auto;
			justify-content: space-between;
		}
		.hamburger {
			display: flex;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav {
			transition: none;
		}
		.mobile-nav.open .mobile-link {
			transition: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('navToggle');
	const panel = document.getElementById('mobileNav');
	const closeBtn = document.getElementById('navClose');

	function setMenu(open: boolean) {
		if (!toggle || !panel) return;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		panel.classList.toggle('open', open);
		panel.setAttribute('aria-hidden', String(!open));
		document.body.style.overflow = open ? 'hidden' : '';
	}

	toggle?.addEventListener('click', () =>
		setMenu(toggle.getAttribute('aria-expanded') !== 'true')
	);
	closeBtn?.addEventListener('click', () => setMenu(false));
	panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setMenu(false);
	});
</script>
