---
const team = [
	{ name: 'Arq. Moises Sumari Jara', title: 'Arquitecto', role: 'CAP', id: '20636', initial: 'MS' },
	{ name: 'Ing. Civil Ruben Melo Laguna', title: 'Ingeniero Civil', role: 'CIP', id: '114010', initial: 'RM' },
	{ name: 'Ing. Electricista Nerbaldo N. Araujo', title: 'Ingeniero Electricista', role: 'CIP', id: '356625', initial: 'NN' },
	{ name: 'Ing. Sanitario Wilmer A. Perez', title: 'Ingeniero Sanitario', role: 'CIP', id: '102980', initial: 'WP' },
];
---

<section class="equipo" id="equipo">
	<div class="container">
		<div class="rule-label">
			<span class="tag">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="2" width="12" height="12" stroke="currentColor" stroke-width="1.2" /><line x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 2" /><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 2" /></svg>
				CUADRO DE FIRMAS
			</span>
		</div>

		<div class="equipo-head">
			<h2 class="equipo-title">Profesionales colegiados que firman tu expediente</h2>
			<p class="equipo-sub">Arquitectura, estructuras, eléctricas y sanitarias. Cada plano lleva sello, número de colegiatura y firma responsable.</p>
		</div>

		<div class="team-grid">
			{team.map((m) => (
				<div class="stamp">
					<div class="stamp-figure" aria-hidden="true">
						<svg viewBox="0 0 160 104" fill="none" class="eng-svg">
							<line x1="80" y1="0" x2="80" y2="104" stroke="var(--line-soft)" stroke-width="0.8" stroke-dasharray="3 3" />
							<line x1="0" y1="52" x2="160" y2="52" stroke="var(--line-soft)" stroke-width="0.8" stroke-dasharray="3 3" />
							<path d="M22 104 C22 82 44 73 80 73 C116 73 138 82 138 104" fill="var(--green-wash)" stroke="var(--ink)" stroke-width="1.2" />
							<path d="M64 73 L73 88 L80 81 L87 88 L96 73" fill="none" stroke="var(--green-deep)" stroke-width="1.2" stroke-linejoin="round" />
							<path d="M30 96 L130 96" stroke="var(--green-deep)" stroke-width="1" stroke-dasharray="4 3" opacity="0.7" />
							<path d="M52 73 L58 88 M108 73 L102 88" stroke="var(--ink)" stroke-width="0.9" opacity="0.6" />
							<rect x="70" y="60" width="20" height="14" fill="var(--paper)" stroke="var(--ink)" stroke-width="1" />
							<ellipse cx="80" cy="49" rx="15" ry="14" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.2" />
							<path d="M53 42 C53 23 64 13 80 13 C96 13 107 23 107 42" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.2" />
							<rect x="76" y="8" width="8" height="10" rx="2" fill="var(--ink)" />
							<rect x="46" y="41" width="68" height="7" rx="3.5" fill="var(--ink)" />
							<line x1="60" y1="24" x2="60" y2="38" stroke="var(--line)" stroke-width="0.8" />
							<line x1="100" y1="24" x2="100" y2="38" stroke="var(--line)" stroke-width="0.8" />
							<circle cx="80" cy="49" r="1.4" fill="var(--ink)" opacity="0.5" />
						</svg>
						<span class="fig-tag tag">{m.role} · Nº {m.id}</span>
					</div>
					<div class="stamp-top">
						<div class="stamp-avatar">{m.initial}</div>
						<!-- Sello rotatorio -->
						<div class="seal">
							<svg viewBox="0 0 72 72" class="seal-svg">
								<circle cx="36" cy="36" r="30" fill="none" stroke="var(--green)" stroke-width="1" stroke-dasharray="3 2" />
								<circle cx="36" cy="36" r="24" fill="none" stroke="var(--green-deep)" stroke-width="0.8" />
								<text font-family="var(--font-mono)" font-size="6.5" font-weight="700" fill="var(--green-deep)">
									<textPath href="#sealPath">{m.role} · COLEGIADO · Nº {m.id} · COLEGIADO · </textPath>
								</text>
								<circle cx="36" cy="36" r="14" fill="none" stroke="var(--green)" stroke-width="0.6" />
								<text x="36" y="36" text-anchor="middle" dominant-baseline="central" font-family="var(--font-mono)" font-size="8" font-weight="700" fill="var(--green-deep)">{m.role}</text>
								<defs>
									<path id="sealPath" d="M36,6 a30,30 0 1,1 0,60 a30,30 0 1,1 0,-60" />
								</defs>
							</svg>
						</div>
					</div>
					<div class="stamp-info">
						<strong>{m.name}</strong>
						<span class="stamp-title">{m.title}</span>
					</div>
					<div class="stamp-sign">
						<svg viewBox="0 0 120 22" fill="none" aria-hidden="true" class="sig-svg">
							<path d="M4 17 C12 3, 28 3, 36 13 S52 19, 60 11 S76 1, 84 9 S100 17, 116 7" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" fill="none" />
						</svg>
						<span class="tag">FIRMA</span>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.equipo {
		padding: clamp(3rem, 8vw, 6rem) 0;
		background: var(--sheet);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.container {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2.5rem);
	}

	.equipo .rule-label {
		margin-bottom: clamp(1.2rem, 3vw, 2rem);
	}

	.equipo-head {
		margin-bottom: clamp(2rem, 4vw, 3rem);
		max-width: 38rem;
	}

	.equipo-title {
		font-stretch: 112%;
		font-weight: 500;
		font-size: clamp(1.6rem, 3.5vw, 2.2rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		margin: 0 0 0.7rem;
	}

	.equipo-sub {
		font-size: 1rem;
		line-height: 1.55;
		color: var(--ink-2);
		margin: 0;
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(1rem, 2vw, 1.5rem);
	}

	.stamp {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 0 0 clamp(1rem, 2vw, 1.5rem);
		border: 1px solid var(--line);
		background: var(--paper);
		transition: border-color 200ms var(--ease-out-expo), box-shadow 200ms var(--ease-out-expo);
		overflow: hidden;
	}

	.stamp-figure {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		padding: 0.8rem 0.8rem 0;
		background:
			linear-gradient(var(--line-soft) 0 0) center/100% 1px no-repeat,
			linear-gradient(var(--line-soft) 0 0) center/1px 100% no-repeat,
			repeating-linear-gradient(0deg, transparent, transparent 15px, color-mix(in srgb, var(--line-soft) 60%, transparent) 15px, color-mix(in srgb, var(--line-soft) 60%, transparent) 16px),
			var(--sheet);
		background-color: var(--sheet);
		border-bottom: 1px solid var(--line-soft);
		min-height: 118px;
	}

	.eng-svg {
		width: 100%;
		max-width: 170px;
		height: auto;
		display: block;
		transition: transform 300ms var(--ease-out-expo);
	}

	.stamp:hover .eng-svg {
		transform: translateY(-3px);
	}

	.fig-tag {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		background: color-mix(in srgb, var(--paper) 88%, transparent);
		border: 1px solid var(--line);
		padding: 0.15rem 0.45rem;
		font-size: 0.6rem;
	}

	.stamp-top,
	.stamp-info,
	.stamp-sign {
		padding-left: clamp(1rem, 2vw, 1.5rem);
		padding-right: clamp(1rem, 2vw, 1.5rem);
	}

	.stamp:hover {
		border-color: var(--green);
		box-shadow: 0 2px 16px rgba(30, 138, 76, 0.08);
	}

	.stamp-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
	}

	.stamp-avatar {
		width: 2.5rem;
		height: 2.5rem;
		background: var(--green-wash);
		border: 1px solid var(--green);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--green-deep);
	}

	/* Sello rotatorio */
	.seal {
		width: 56px;
		height: 56px;
		opacity: 0.2;
		transition: opacity 400ms var(--ease-out-expo), transform 600ms var(--ease-out-expo);
	}

	.stamp:hover .seal {
		opacity: 1;
		transform: rotate(180deg);
	}

	.seal-svg {
		width: 100%;
		height: 100%;
	}

	.stamp-info {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.stamp-info strong {
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.stamp-title {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--ink-3);
	}

	.stamp-sign {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--line-soft);
	}

	.sig-svg {
		width: 100%;
		height: 18px;
	}

	@media (max-width: 54rem) {
		.team-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 30rem) {
		.team-grid { grid-template-columns: 1fr; }
	}
</style>
