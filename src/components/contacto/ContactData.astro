---
import { siteContact } from "../../data/site";
---

<dl class="contact-data">
  <div class="data-row">
    <span class="data-ico" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4.5 2.5h2.6l1.4 3.4-1.7 1.2a9.5 9.5 0 0 0 3.1 3.1l1.2-1.7 3.4 1.4v2.6a1.5 1.5 0 0 1-1.5 1.5A12 12 0 0 1 3 4a1.5 1.5 0 0 1 1.5-1.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
    </span>
    <div class="data-body">
      <dt class="tag">Teléfono</dt>
      <dd><a href={siteContact.tel}>{siteContact.phoneDisplay}</a></dd>
    </div>
  </div>
  <div class="data-row">
    <span class="data-ico" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="10" rx="1" stroke="currentColor" stroke-width="1.3" /><polyline points="2,3 8,9 14,3" stroke="currentColor" stroke-width="1.3" fill="none" /></svg>
    </span>
    <div class="data-body">
      <dt class="tag">Correo</dt>
      <dd>
        <a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
      </dd>
    </div>
  </div>
  <div class="data-row">
    <span class="data-ico" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 14.5S3.5 10 3.5 6.5a4.5 4.5 0 0 1 9 0C12.5 10 8 14.5 8 14.5z" stroke="currentColor" stroke-width="1.3" /><circle cx="8" cy="6.5" r="1.6" stroke="currentColor" stroke-width="1.3" /></svg>
    </span>
    <div class="data-body">
      <dt class="tag">Oficina</dt>
      <dd>{siteContact.address}</dd>
    </div>
  </div>
</dl>
