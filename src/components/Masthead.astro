---
interface Props {
	phone?: string;
}

const { phone = '929 057 970' } = Astro.props;
const tel = 'tel:+51' + phone.replace(/\s/g, '');
---

<header class="masthead" id="inicio">
	<div class="masthead-inner">
		<a class="brand" href="#inicio" aria-label="Construcciones Sostenibles — inicio">
			<img src="/logo.png" alt="" width="44" height="44" />
			<span class="brand-name">
				Construcciones <br /><strong>Sostenibles</strong>
			</span>
		</a>

		<nav class="nav" aria-label="Navegación principal">
			<a href="#servicios">Servicios</a>
			<a href="#equipo">Equipo</a>
			<a href="#proceso">Proceso</a>
			<a href="#proyectos">Proyectos</a>
			<a href="#contacto">Contacto</a>
		</nav>

		<a class="phone" href={tel}>
			<span class="tag">Línea directa</span>
			<span class="phone-num">{phone}</span>
		</a>
	</div>
</header>

<style>
	.masthead {
		border-bottom: 1px solid var(--ink);
		background: color-mix(in srgb, var(--sheet) 88%, transparent);
		backdrop-filter: blur(6px);
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.masthead-inner {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2.5rem);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: stretch;
		gap: clamp(1rem, 3vw, 2.5rem);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 0;
		text-decoration: none;
	}

	.brand img {
		width: 42px;
		height: 42px;
		object-fit: contain;
	}

	.brand-name {
		font-stretch: 112%;
		font-weight: 500;
		font-size: 0.8125rem;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.brand-name strong {
		font-weight: 800;
	}

	.nav {
		display: flex;
		align-items: stretch;
		justify-content: center;
	}

	.nav a {
		display: flex;
		align-items: center;
		padding: 0 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-2);
		border-left: 1px solid var(--line-soft);
		transition: color 200ms var(--ease-out-expo), background 200ms var(--ease-out-expo);
	}

	.nav a:last-child {
		border-right: 1px solid var(--line-soft);
	}

	.nav a:hover {
		color: var(--green-deep);
		background: var(--green-wash);
	}

	.phone {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.1rem;
		text-decoration: none;
		text-align: right;
		padding: 0.4rem 0;
	}

	.phone-num {
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--ink);
	}

	.phone:hover .phone-num {
		color: var(--green-deep);
	}

	@media (max-width: 54rem) {
		.nav {
			display: none;
		}
		.masthead-inner {
			grid-template-columns: auto auto;
			justify-content: space-between;
		}
	}
</style>
