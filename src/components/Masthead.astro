---
interface Props {
	phone?: string;
}

const { phone = '929 057 970' } = Astro.props;
const waLink =
	'https://wa.me/51929057970?text=Hola%20Construcciones%20Sostenibles%2C%20necesito%20cotizar%20planos%20firmados%20para%20mi%20proyecto.%20%C2%BFMe%20pueden%20ayudar%3F';

const links = [
	{ href: '#servicios', label: 'Servicios' },
	{ href: '#equipo', label: 'Equipo' },
	{ href: '#proceso', label: 'Proceso' },
	{ href: '#proyectos', label: 'Proyectos' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="masthead" id="inicio">
	<div class="masthead-inner">
		<a class="brand" href="#inicio" aria-label="Construcciones Sostenibles — inicio">
			<img src="/isotipo.png" alt="" width="44" height="44" />
			<span class="brand-name">
				Construcciones <br /><strong>Sostenibles</strong>
			</span>
		</a>

		<nav class="nav" aria-label="Navegación principal">
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>

		<a class="phone" href={waLink} target="_blank" rel="noopener" aria-label="Cotiza por WhatsApp al 929 057 970">
			<span class="wa-badge" aria-hidden="true">
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
					class="wa-icon"
				>
					<path
						d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5L9.3 8.2c-.2-.5-.5-.4-.6-.4h-.5c-.2 0-.5.2-.7.3-.9.9-1.1 2.2-.2 3.9a11.6 11.6 0 0 0 4.5 4.2c1.7.8 2.4.9 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.3-.4z"
					></path>
				</svg>
			</span>
			<span class="phone-text">
				<span class="phone-tag"><span class="live-dot" aria-hidden="true"></span>Cotiza por WhatsApp</span>
				<span class="phone-num">{phone}</span>
			</span>
			<span class="phone-arrow" aria-hidden="true">↗</span>
		</a>

		<button class="hamburger" id="navToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileNav">
			<span></span><span></span><span></span>
		</button>
	</div>
</header>

<div class="mobile-nav" id="mobileNav" aria-hidden="true">
	<div class="mobile-nav-head">
		<span class="tag">ÍNDICE DE LÁMINA</span>
		<button class="mobile-close" id="navClose" aria-label="Cerrar menú">
			<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1 L13 13 M13 1 L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
		</button>
	</div>
	<nav class="mobile-nav-links" aria-label="Navegación móvil">
		{links.map((l, i) => (
			<a href={l.href} class="mobile-link" style={`--i:${i}`}>
				<span class="ml-num">0{i + 1}</span>
				<span class="ml-label">{l.label}</span>
				<span class="ml-arrow" aria-hidden="true">→</span>
			</a>
		))}
	</nav>
	<div class="mobile-nav-foot">
		<a href={waLink} target="_blank" rel="noopener" class="mobile-phone">
			<span aria-hidden="true">●</span> WhatsApp {phone} ↗
		</a>
		<span class="tag">SMP · LIMA · PERÚ</span>
	</div>
</div>

<style>
	.masthead {
		border-bottom: 1px solid var(--ink);
		background: color-mix(in srgb, var(--sheet) 88%, transparent);
		backdrop-filter: blur(6px);
		position: sticky;
		top: 0;
		z-index: 60;
		height: var(--masthead-h);
		flex-shrink: 0;
	}

	.masthead-inner {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2.5rem);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: stretch;
		gap: clamp(1rem, 3vw, 2.5rem);
		height: var(--masthead-h);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 0;
		text-decoration: none;
	}

	.brand img {
		width: 42px;
		height: 42px;
		object-fit: contain;
	}

	.brand-name {
		font-stretch: 112%;
		font-weight: 500;
		font-size: 0.8125rem;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.brand-name strong {
		font-weight: 800;
	}

	.nav {
		display: flex;
		align-items: stretch;
		justify-content: center;
	}

	.nav a {
		display: flex;
		align-items: center;
		padding: 0 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-2);
		border-left: 1px solid var(--line-soft);
		position: relative;
		transition: color 200ms var(--ease-out-expo);
	}

	.nav a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--green);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 250ms var(--ease-out-expo);
	}

	.nav a:last-child {
		border-right: 1px solid var(--line-soft);
	}

	.nav a:hover {
		color: var(--green-deep);
	}

	.nav a:hover::after {
		transform: scaleX(1);
	}

	.phone {
		align-self: center;
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		background: var(--green);
		color: var(--sheet);
		border: 1px solid var(--ink);
		padding: 0.45rem 0.7rem 0.45rem 0.45rem;
		text-decoration: none;
		box-shadow: 3px 3px 0 var(--ink);
		transition:
			background 200ms var(--ease-out-expo),
			transform 150ms var(--ease-out-expo),
			box-shadow 150ms var(--ease-out-expo);
	}

	.phone:hover {
		background: var(--green-deep);
		transform: translate(-1px, -1px);
		box-shadow: 4px 4px 0 var(--ink);
	}

	.phone:active {
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 var(--ink);
	}

	.phone:focus-visible {
		outline: 2px dashed var(--green-deep);
		outline-offset: 3px;
	}

	.wa-badge {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		flex-shrink: 0;
		background: rgba(255, 255, 255, 0.14);
		border: 1px solid rgba(255, 255, 255, 0.4);
	}

	.wa-icon {
		display: block;
	}

	.phone-text {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.1rem;
		line-height: 1.1;
	}

	.phone-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.9;
	}

	.live-dot {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
		animation: wa-ping 2s infinite;
	}

	@keyframes wa-ping {
		0% {
			box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.65);
		}
		70% {
			box-shadow: 0 0 0 7px rgba(255, 255, 255, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
		}
	}

	.phone-num {
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--sheet);
	}

	.phone-arrow {
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		opacity: 0.75;
		transition: transform 200ms var(--ease-out-expo);
	}

	.phone:hover .phone-arrow {
		transform: translate(2px, -2px);
	}

	/* ---- hamburguesa ---- */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: 1px solid var(--line);
		width: 44px;
		height: 44px;
		padding: 0 10px;
		cursor: pointer;
		align-self: center;
	}

	.hamburger span {
		display: block;
		height: 1.5px;
		background: var(--ink);
		transition: transform 250ms var(--ease-out-expo), opacity 200ms;
	}

	.hamburger[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}
	.hamburger[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}
	.hamburger[aria-expanded='true'] span:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}

	/* ---- nav móvil ---- */
	.mobile-nav {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: var(--paper);
		background-image:
			linear-gradient(to right, var(--grid) 1px, transparent 1px),
			linear-gradient(to bottom, var(--grid) 1px, transparent 1px),
			linear-gradient(to right, var(--grid-strong) 1px, transparent 1px),
			linear-gradient(to bottom, var(--grid-strong) 1px, transparent 1px);
		background-size: 28px 28px, 28px 28px, 140px 140px, 140px 140px;
		display: flex;
		flex-direction: column;
		padding: 1.2rem;
		clip-path: inset(0 0 100% 0);
		transition: clip-path 500ms var(--ease-out-expo);
		visibility: hidden;
	}

	.mobile-nav.open {
		clip-path: inset(0 0 0 0);
		visibility: visible;
	}

	.mobile-nav-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--ink);
	}

	.mobile-close {
		background: none;
		border: 1px solid var(--line);
		width: 42px;
		height: 42px;
		font-size: 1rem;
		color: var(--ink);
		cursor: pointer;
	}

	.mobile-nav-links {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2rem;
	}

	.mobile-link {
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		align-items: center;
		padding: 0.9rem 0.4rem;
		text-decoration: none;
		border-bottom: 1px solid var(--line);
		opacity: 0;
		transform: translateY(14px);
	}

	.mobile-nav.open .mobile-link {
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 400ms var(--ease-out-expo) calc(var(--i) * 60ms + 200ms),
			transform 400ms var(--ease-out-expo) calc(var(--i) * 60ms + 200ms);
	}

	.ml-num {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--ink-3);
	}

	.ml-label {
		font-stretch: 112%;
		font-size: 1.6rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.ml-arrow {
		font-size: 1.2rem;
		color: var(--green-deep);
		transition: transform 200ms var(--ease-out-expo);
	}

	.mobile-link:hover .ml-arrow {
		transform: translateX(6px);
	}

	.mobile-nav-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1rem;
		border-top: 1px solid var(--ink);
	}

	.mobile-phone {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		color: var(--sheet);
		background: var(--green);
		border: 1px solid var(--ink);
		box-shadow: 3px 3px 0 var(--ink);
		padding: 0.7rem 1.1rem;
		text-decoration: none;
	}

	@media (max-width: 54rem) {
		.nav,
		.phone {
			display: none;
		}
		.masthead-inner {
			grid-template-columns: auto auto;
			justify-content: space-between;
		}
		.hamburger {
			display: flex;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav {
			transition: none;
		}
		.mobile-nav.open .mobile-link {
			transition: none;
		}
		.live-dot {
			animation: none;
		}
		.phone,
		.phone:hover,
		.phone:active {
			transform: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('navToggle');
	const panel = document.getElementById('mobileNav');
	const closeBtn = document.getElementById('navClose');

	function setMenu(open: boolean) {
		if (!toggle || !panel) return;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		panel.classList.toggle('open', open);
		panel.setAttribute('aria-hidden', String(!open));
		document.body.style.overflow = open ? 'hidden' : '';
	}

	toggle?.addEventListener('click', () =>
		setMenu(toggle.getAttribute('aria-expanded') !== 'true')
	);
	closeBtn?.addEventListener('click', () => setMenu(false));
	panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setMenu(false);
	});
</script>
