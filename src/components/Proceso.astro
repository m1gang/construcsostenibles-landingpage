---
import "../styles/proceso.css";
import { steps } from "../data/proceso";
import ProcessStep from "./proceso/ProcessStep.astro";
---

<section class="proceso section" id="proceso">
  <div class="container">
    <div class="rule-label">
      <span class="tag">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" /><polyline points="8,4 8,8 11,10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
        FORMA DE PAGO
      </span>
    </div>

    <div class="section-head">
      <h2 class="section-title">Un proceso simple, con pagos atados a entregas</h2>
      <p class="section-sub">Sabrás qué recibes en cada etapa antes de avanzar. Todo queda por escrito en el contrato, sin letras pequeñas.</p>
    </div>

    <div class="steps grid grid-cols-[repeat(3,1fr)] gap-[clamp(1rem,2vw,2rem)] max-[48rem]:grid-cols-1 max-[48rem]:gap-0">
      {steps.map((s, i) => (
        <ProcessStep step={s} showConnector={i < steps.length - 1} />
      ))}
    </div>
  </div>
</section>
