---
const contact = {
	phone: '+51 929 057 970',
	tel: 'tel:+51929057970',
	email: 'construveli.sac@gmail.com',
	address: 'Av. Gerardo Unger Nº 277, 1er piso – SMP, Lima',
};
---

<section class="contacto" id="contacto">
	<div class="container">
		<div class="rule-label">
			<span class="tag">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1" stroke="currentColor" stroke-width="1.2" /><polyline points="2,3 8,9 14,3" stroke="currentColor" stroke-width="1.2" fill="none" /></svg>
				CONTACTO
			</span>
		</div>

		<div class="contact-grid">
			<div class="contact-info">
				<h2 class="contact-title">¿Necesita planos firmados o gestiones técnicas? Atendemos a nivel nacional</h2>
				<p class="contact-sub">
					Escriba o llame directamente. Respondemos en horario laboral de lunes a viernes.
				</p>

				<dl class="contact-data">
					<div class="data-row">
						<dt class="tag">Teléfono</dt>
						<dd><a href={contact.tel}>{contact.phone}</a></dd>
					</div>
					<div class="data-row">
						<dt class="tag">Correo</dt>
						<dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
					</div>
					<div class="data-row">
						<dt class="tag">Oficina</dt>
						<dd>{contact.address}</dd>
					</div>
				</dl>
			</div>

			<div class="contact-cta">
				<a href={contact.tel} class="cta-phone">
					<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path d="M3 4.5A1.5 1.5 0 014.5 3h1.186a1 1 0 01.95.684l.787 2.36a1 1 0 01-.282 1.018l-1.09.924a10.042 10.042 0 004.436 4.436l.924-1.09a1 1 0 011.018-.282l2.36.787a1 1 0 01.684.95V15.5a1.5 1.5 0 01-1.5 1.5A13.5 13.5 0 013 4.5z" stroke="currentColor" stroke-width="1.4" />
					</svg>
					Llamar ahora
				</a>
				<a href={`mailto:${contact.email}?subject=Solicitud de planos`} class="cta-email">
					<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<rect x="2" y="4" width="16" height="12" rx="1" stroke="currentColor" stroke-width="1.4" />
						<polyline points="2,4 10,11 18,4" stroke="currentColor" stroke-width="1.4" fill="none" />
					</svg>
					Escribir correo
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contacto {
		padding: clamp(3rem, 8vw, 6rem) 0;
	}

	.container {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2.5rem);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.contact-title {
		font-stretch: 112%;
		font-weight: 500;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		margin-bottom: 0.8rem;
	}

	.contact-sub {
		font-size: 1rem;
		color: var(--ink-2);
		margin-bottom: 2rem;
	}

	.contact-data {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 0;
		padding: 0;
	}

	.data-row {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: 0.75rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--line-soft);
	}

	.data-row dt {
		padding-top: 0.15rem;
	}

	.data-row dd {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
	}

	.data-row dd a {
		text-decoration: none;
		transition: color 200ms var(--ease-out-expo);
	}

	.data-row dd a:hover {
		color: var(--green-deep);
	}

	.contact-cta {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		background: var(--sheet);
		border: 1px solid var(--line);
		padding: clamp(1.2rem, 3vw, 2rem);
	}

	.cta-phone,
	.cta-email {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 1rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background 200ms var(--ease-out-expo), color 200ms var(--ease-out-expo);
	}

	.cta-phone {
		background: var(--green);
		color: var(--sheet);
	}

	.cta-phone:hover {
		background: var(--green-deep);
	}

	.cta-email {
		border: 1px solid var(--ink);
		background: transparent;
		color: var(--ink);
	}

	.cta-email:hover {
		background: var(--ink);
		color: var(--sheet);
	}

	@media (max-width: 48rem) {
		.contact-grid {
			grid-template-columns: 1fr;
		}

		.data-row {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
