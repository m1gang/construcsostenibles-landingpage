---
const items = [
	'Licencia de construcción',
	'Planos sismorresistentes',
	'Instalaciones eléctricas',
	'Instalaciones sanitarias',
	'Declaratoria de fábrica',
	'ITSE · Defensa Civil',
	'Medidor agua / luz',
	'Domótica · Paneles solares',
	'Prescripción adquisitiva',
	'Estudio de suelo',
	'Estructuras metálicas',
	'Servicio de firmas',
];
---

<div class="cinta" aria-hidden="true">
	<div class="cinta-track">
		{[...items, ...items].map((item, i) => (
			<span class="cinta-item">
				{item}
				{((i + 1) % items.length !== 0) && <svg class="cinta-dot" width="6" height="6" viewBox="0 0 6 6"><rect x="1" y="1" width="4" height="4" fill="var(--green)" /></svg>}
			</span>
		))}
	</div>
</div>

<style>
	.cinta {
		overflow: hidden;
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
		padding: 0.65rem 0;
		background: var(--sheet);
	}

	.cinta-track {
		display: flex;
		gap: 2.5rem;
		width: max-content;
		animation: scroll-cinta 40s linear infinite;
	}

	.cinta-item {
		display: flex;
		align-items: center;
		gap: 2.5rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-2);
		white-space: nowrap;
	}

	.cinta-dot {
		flex-shrink: 0;
	}

	@keyframes scroll-cinta {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.cinta-track { animation: none; }
	}
</style>
