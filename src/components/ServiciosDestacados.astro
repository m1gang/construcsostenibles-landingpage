---
import { Image } from "astro:assets";
import "../styles/destacados.css";
import { destacados, waLinkFor } from "../data/destacados";

const waIcon = `M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5L9.3 8.2c-.2-.5-.5-.4-.6-.4h-.5c-.2 0-.5.2-.7.3-.9.9-1.1 2.2-.2 3.9a11.6 11.6 0 0 0 4.5 4.2c1.7.8 2.4.9 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.3-.4z`;
---

<section class="destacados section" id="destacados" aria-labelledby="destacados-title">
  <div class="container">
    <div class="rule-label">
      <span class="tag">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="12" height="12" stroke="currentColor" stroke-width="1.2"></rect>
          <line x1="2" y1="5.5" x2="14" y2="5.5" stroke="currentColor" stroke-width="0.8"></line>
          <line x1="5.5" y1="5.5" x2="5.5" y2="14" stroke="currentColor" stroke-width="0.8"></line>
        </svg>
        LÁMINAS DE SERVICIO
      </span>
    </div>

    <div class="dest-head">
      <div class="section-head">
        <h2 class="section-title" id="destacados-title">Los servicios que más nos solicitan</h2>
        <p class="section-sub">
          Una selección de los servicios más pedidos, resueltos por el mismo equipo
          colegiado: planos y licencias, saneamiento registral, inspección ITSE, estudio
          de suelos, energía solar, seguridad eléctrica y ploteos. El resto de nuestro
          catálogo está en el índice completo.
        </p>
      </div>
      <a class="dest-jump" href="#servicios">
        <span class="tag">Índice completo</span>
        <span class="dest-jump-text">Ver todos los servicios</span>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 2.5v10M4.5 9l3.5 3.5L11.5 9" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="dest-grid">
      {
        destacados.map((d, i) => (
          <article class="dest-card" aria-labelledby={`dest-${d.frame}`}>
            <div class="dest-media">
              <Image
                src={d.foto}
                alt={d.alt}
                width={1080}
                height={1350}
                densities={[1, 1.5, 2]}
                class="dest-flyer"
                loading={i < 3 ? "eager" : "lazy"}
                decoding="async"
              />

              <div class="dest-overlay">
                <p class="dest-badge">{d.badge}</p>
                <p class="dest-desc">{d.text}</p>
                <p class="tag dest-meta">{d.meta}</p>
                <a
                  class="dest-wa"
                  href={waLinkFor(d.waText)}
                  target="_blank"
                  rel="noopener"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={waIcon} />
                  </svg>
                  Cotizar por WhatsApp
                </a>
              </div>
            </div>

            <div class="dest-caption">
              <span class="tag dest-code">{d.frame}</span>
              <h3 class="dest-title" id={`dest-${d.frame}`}>
                {d.title}
              </h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
