---
import { siteContact } from "../../data/site";
import { heroCopy, heroMetrics, heroSlides } from "../../data/hero";

const first = heroSlides[0];
---

<div class="hero-left">
  <div class="hero-placa tag">
    <span>LÁMINA</span>
    <span class="placa-sep">|</span>
    <span data-hero-frame>{first.frame}</span>
  </div>

  <h1 class="hero-title" aria-live="polite">
    <span class="hero-fade" data-hero-text>
      <span class="hl" data-hero-title>{first.title}</span>
      <span class="hl hl-accent" data-hero-accent>{first.accent}</span>
    </span>
  </h1>

  <p class="hero-sub hero-fade" data-hero-sub>
    {first.sub}
  </p>

  <p class="hero-service tag" data-hero-tag>{first.tag}</p>

  <div class="hero-ctas">
    <a
      href={siteContact.waLink}
      target="_blank"
      rel="noopener"
      class="cta-primary magnet"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5L9.3 8.2c-.2-.5-.5-.4-.6-.4h-.5c-.2 0-.5.2-.7.3-.9.9-1.1 2.2-.2 3.9a11.6 11.6 0 0 0 4.5 4.2c1.7.8 2.4.9 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.3-.4z"
        ></path>
      </svg>
      <span data-hero-cta>{heroCopy.primaryCta}</span>
    </a>
    <a href={heroCopy.secondaryHref} class="cta-secondary magnet"
      >{heroCopy.secondaryCta}</a
    >
  </div>

  <div class="hero-data">
    {
      heroMetrics.map((m) => (
        <div class="hd">
          <span class="tag">{m.tag}</span>
          <span class="hd-val">{m.value}</span>
        </div>
      ))
    }
  </div>
</div>
