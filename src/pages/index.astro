---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import Hero from '../components/Hero.astro';
import Cinta from '../components/Cinta.astro';
import Servicios from '../components/Servicios.astro';
import Equipo from '../components/Equipo.astro';
import Proceso from '../components/Proceso.astro';
import Proyectos from '../components/Proyectos.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Planos de obra firmados en Perú | Construcciones Sostenibles">
	<!-- Cursor seguidor -->
	<div class="cursor-follower" id="cursorFollower" aria-hidden="true">
		<svg width="32" height="32" viewBox="0 0 32 32">
			<line x1="16" y1="0" x2="16" y2="12" stroke="var(--green)" stroke-width="0.8" />
			<line x1="16" y1="20" x2="16" y2="32" stroke="var(--green)" stroke-width="0.8" />
			<line x1="0" y1="16" x2="12" y2="16" stroke="var(--green)" stroke-width="0.8" />
			<line x1="20" y1="16" x2="32" y2="16" stroke="var(--green)" stroke-width="0.8" />
			<circle cx="16" cy="16" r="2" fill="var(--green)" />
		</svg>
	</div>

	<!-- Barra de progreso -->
	<div class="progress-bar" id="progressBar" aria-hidden="true">
		<div class="progress-fill" id="progressFill"></div>
		<div class="progress-ticks">
			{[0, 25, 50, 75, 100].map((n) => (
				<span class="ptick" style={`left:${n}%`}>{n}</span>
			))}
		</div>
	</div>

	<Masthead />
	<main>
		<Hero />
		<Cinta />
		<Servicios />
		<Equipo />
		<Proceso />
		<Proyectos />
		<Contacto />
	</main>
	<Footer />

	<script>
		// ---- Cursor seguidor (solo punteros) ----
		const follower = document.getElementById('cursorFollower');
		if (follower && window.matchMedia('(pointer: fine)').matches) {
			let mx = 0, my = 0, fx = 0, fy = 0;
			document.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
			(function tick() {
				fx += (mx - fx) * 0.12;
				fy += (my - fy) * 0.12;
				follower.style.transform = `translate(${fx - 16}px, ${fy - 16}px)`;
				requestAnimationFrame(tick);
			})();
			document.body.classList.add('has-cursor');
		}

		// ---- Barra de progreso ----
		const fill = document.getElementById('progressFill');
		if (fill) {
			const update = () => {
				const h = document.documentElement.scrollHeight - window.innerHeight;
				const pct = h > 0 ? (window.scrollY / h) : 0;
				fill.style.transform = `scaleX(${pct})`;
			};
			window.addEventListener('scroll', update, { passive: true });
			update();
		}

		// ---- Reveal on scroll ----
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.1 }
		);

		document.querySelectorAll('section, .stamp, .step, .plate').forEach((el) => {
			el.classList.add('reveal');
			observer.observe(el);
		});
	</script>
</Layout>

<style is:global>
	/* Cursor */
	.cursor-follower {
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		z-index: 9999;
		mix-blend-mode: difference;
		opacity: 0;
		transition: opacity 300ms;
	}
	.has-cursor .cursor-follower { opacity: 1; }

	/* Barra de progreso */
	.progress-bar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 70;
		background: var(--line);
	}
	.progress-fill {
		height: 100%;
		width: 100%;
		background: var(--green);
		transform-origin: left;
		transform: scaleX(0);
		transition: transform 80ms linear;
		will-change: transform;
	}
	.progress-ticks {
		position: absolute;
		top: 3px;
		left: 0;
		right: 0;
	}
	.ptick {
		position: absolute;
		font-family: var(--font-mono);
		font-size: 0.5rem;
		color: var(--ink-3);
		transform: translateX(-50%);
		top: 2px;
		opacity: 0.5;
	}

	/* Reveal */
	.reveal {
		opacity: 0;
		transform: translateY(22px);
		transition: opacity 650ms var(--ease-out-expo), transform 650ms var(--ease-out-expo);
	}
	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor-follower { display: none; }
		.progress-fill { transition: none; }
		.reveal { opacity: 1; transform: none; transition: none; }
	}
</style>
