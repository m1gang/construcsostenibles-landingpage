---
const hero = {
	phone: '+51929057970',
	email: 'construveli.sac@gmail.com',
};
---

<section class="hero" id="hero">
	<!-- Marcas de corte esquina -->
	<svg class="corner corner-tl" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M0 16 L0 0 L16 0" stroke="var(--ink)" stroke-width="1.2" fill="none"/></svg>
	<svg class="corner corner-tr" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 0 L32 0 L32 16" stroke="var(--ink)" stroke-width="1.2" fill="none"/></svg>
	<svg class="corner corner-bl" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M0 16 L0 32 L16 32" stroke="var(--ink)" stroke-width="1.2" fill="none"/></svg>
	<svg class="corner corner-br" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 32 L32 32 L32 16" stroke="var(--ink)" stroke-width="1.2" fill="none"/></svg>

	<div class="hero-grid">
		<!-- Columna izquierda: contenido -->
		<div class="hero-left">
			<div class="hero-placa tag">
				<span>PLANO</span>
				<span class="placa-sep">|</span>
				<span>Nº CS-01</span>
			</div>

			<h1 class="hero-title">
				<span class="hl">Planos de obra,</span>
				<span class="hl">firmados y</span>
				<span class="hl hl-accent">aprobados.</span>
			</h1>

			<p class="hero-sub">
				Del cálculo estructural a la licencia de construcción. Equipo colegiado
				completo, gestión integral y energía sostenible para tu proyecto.
			</p>

			<div class="hero-ctas">
				<a href={`mailto:${hero.email}?subject=Solicitud de planos`} class="cta-primary magnet">
					Solicitar planos
				</a>
				<a href="#servicios" class="cta-secondary magnet">Ver servicios</a>
			</div>

			<div class="hero-data">
				<div class="hd">
					<span class="tag">Equipo</span>
					<span class="hd-val">4 profesionales</span>
				</div>
				<div class="hd">
					<span class="tag">Firmas</span>
					<span class="hd-val">CAP + CIP</span>
				</div>
				<div class="hd">
					<span class="tag">Sede</span>
					<span class="hd-val">Lima, Perú</span>
				</div>
			</div>
		</div>

		<!-- Columna derecha: placa de levantamiento -->
		<div class="hero-right">
			<div class="plate-frame">
				<svg class="plate-svg" viewBox="0 0 520 420" fill="none" aria-hidden="true">
					<defs>
						<pattern id="hg" width="16" height="16" patternUnits="userSpaceOnUse">
							<path d="M 16 0 L 0 0 0 16" fill="none" stroke="var(--grid)" stroke-width="0.4" />
						</pattern>
						<pattern id="hgM" width="80" height="80" patternUnits="userSpaceOnUse">
							<path d="M 80 0 L 0 0 0 80" fill="none" stroke="var(--grid-strong)" stroke-width="0.6" />
						</pattern>
						<mask id="contourMask"><rect width="520" height="420" fill="white"/></mask>
					</defs>
					<rect width="520" height="420" fill="url(#hg)" />
					<rect width="520" height="420" fill="url(#hgM)" />

					<!-- Curvas de nivel — se dibujan con animación -->
					<g mask="url(#contourMask)">
						<path class="contour c1" d="M20 360 C80 330 140 300 210 275 S310 240 380 215 S460 185 520 160" stroke="var(--line)" stroke-width="0.7" fill="none" stroke-dasharray="4 2" />
						<path class="contour c2" d="M0 300 C60 265 130 240 200 215 S290 180 370 155 S450 125 520 100" stroke="var(--ink-3)" stroke-width="0.9" fill="none" stroke-dasharray="4 2" />
						<path class="contour c3" d="M40 240 C100 210 160 185 230 160 S320 130 400 105 S480 75 520 55" stroke="var(--ink-2)" stroke-width="1.1" fill="none" />
						<path class="contour c4" d="M0 180 C50 155 110 135 175 115 S260 85 340 65 S430 40 520 20" stroke="var(--ink-3)" stroke-width="0.8" fill="none" stroke-dasharray="4 2" />
						<path class="contour c5" d="M80 400 C120 385 170 365 230 345 S320 310 400 285 S470 260 520 245" stroke="var(--line-soft)" stroke-width="0.6" fill="none" stroke-dasharray="2 3" />
						<path class="contour c6" d="M0 120 C40 100 90 82 145 65 S230 40 310 22 S400 5 480 0" stroke="var(--ink-3)" stroke-width="0.7" fill="none" stroke-dasharray="3 2" />
					</g>

					<!-- Estaciones -->
					<g class="stations">
						<circle cx="130" cy="220" r="3" fill="var(--ink)" /><text x="138" y="218" class="st-label">E-01</text>
						<circle cx="310" cy="170" r="3" fill="var(--ink)" /><text x="318" y="168" class="st-label">E-02</text>
						<circle cx="440" cy="110" r="3" fill="var(--ink)" /><text x="448" y="108" class="st-label">E-03</text>
						<circle cx="220" cy="290" r="3" fill="var(--ink)" /><text x="228" y="288" class="st-label">E-04</text>
						<circle cx="380" cy="250" r="3" fill="var(--ink)" /><text x="388" y="248" class="st-label">E-05</text>
					</g>

					<!-- Norte con aguja -->
					<g class="north" id="northNeedle" transform="translate(458, 355)">
						<circle r="20" fill="var(--sheet)" stroke="var(--ink)" stroke-width="1" />
						<line class="needle" y1="-13" y2="8" stroke="var(--ink)" stroke-width="1.5" />
						<polygon class="needle" points="-4,8 4,8 0,15" fill="var(--ink)" />
						<text y="-17" text-anchor="middle" class="north-label">N</text>
					</g>

					<!-- Escala -->
					<g transform="translate(16, 390)" class="scale-bar">
						<line x1="0" y1="0" x2="100" y2="0" stroke="var(--ink)" stroke-width="1" />
						<line x1="0" y1="-3" x2="0" y2="3" stroke="var(--ink)" stroke-width="1" />
						<line x1="50" y1="-3" x2="50" y2="3" stroke="var(--ink)" stroke-width="1" />
						<line x1="100" y1="-3" x2="100" y2="3" stroke="var(--ink)" stroke-width="1" />
						<text y="13">0</text>
						<text x="50" y="13" text-anchor="middle">50 m</text>
						<text x="100" y="13" text-anchor="end">100 m</text>
					</g>

					<!-- Coordenadas -->
					<g class="utm-ticks">
						<text x="16" y="412">8 676 432 N</text>
						<text x="420" y="412">8 676 350 N</text>
						<text x="16" y="14">277 165 E</text>
						<text x="430" y="14">277 275 E</text>
					</g>

					<!-- Borde -->
					<rect x="1" y="1" width="518" height="418" stroke="var(--ink)" stroke-width="1.4" fill="none" />
				</svg>

				<!-- Tooltip de medición -->
				<div class="measure-chip" id="measureChip">
					<span id="measureE">E 277 165</span>
					<span class="mc-sep">/</span>
					<span id="measureN">N 8 676 432</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(5.5rem, 12vw, 8rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 5vw, 4rem);
		overflow: hidden;
		box-sizing: border-box;
	}

	@media (min-width: 54.01rem) {
		.hero {
			height: calc(100vh - var(--masthead-h));
			height: calc(100svh - var(--masthead-h));
			min-height: 540px;
			max-height: none;
			padding-top: clamp(1rem, 3vh, 2rem);
			padding-bottom: clamp(1rem, 3vh, 2rem);
		}

		.hero-grid {
			max-height: 100%;
			gap: clamp(1.5rem, 4vw, 4rem);
		}

		.hero-left {
			gap: clamp(0.7rem, 1.8vh, 1.1rem);
			min-width: 0;
		}

		.hero-title {
			font-size: clamp(2.2rem, 4.2vw, 3.6rem);
		}

		.hero-sub {
			font-size: clamp(0.9rem, 1.2vw, 1.05rem);
		}

		.plate-frame {
			max-width: min(100%, 34rem);
			width: 100%;
		}

		.plate-svg {
			max-height: calc(100vh - var(--masthead-h) - 7rem);
			max-height: calc(100svh - var(--masthead-h) - 7rem);
			width: 100%;
			margin: 0 auto;
		}
	}

	.corner {
		position: absolute;
		opacity: 0.45;
	}
	.corner-tl { top: 1.2rem; left: 1.2rem; }
	.corner-tr { top: 1.2rem; right: 1.2rem; }
	.corner-bl { bottom: 1.2rem; left: 1.2rem; }
	.corner-br { bottom: 1.2rem; right: 1.2rem; }

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: clamp(2rem, 5vw, 5rem);
		max-width: 76rem;
		width: 100%;
		margin: 0 auto;
		align-items: center;
	}

	.hero-left {
		display: flex;
		flex-direction: column;
		gap: clamp(0.9rem, 2vw, 1.4rem);
	}

	.hero-placa {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		width: fit-content;
		border: 1px solid var(--line);
		padding: 0.3rem 0.8rem;
		background: var(--sheet);
	}

	.placa-sep { color: var(--line); }

	.hero-title {
		font-stretch: 120%;
		font-weight: 500;
		font-size: clamp(2.4rem, 6.5vw, 4.8rem);
		line-height: 0.97;
		letter-spacing: -0.038em;
		display: flex;
		flex-direction: column;
	}

	.hl {
		display: block;
		clip-path: inset(0 0 100% 0);
		animation: line-reveal 700ms var(--ease-out-expo) forwards;
	}
	.hl:nth-child(2) { animation-delay: 120ms; }
	.hl:nth-child(3) { animation-delay: 240ms; }

	.hl-accent {
		font-weight: 900;
		color: var(--green-deep);
	}

	@keyframes line-reveal {
		to { clip-path: inset(0 0 0 0); }
	}

	.hero-sub {
		max-width: 30rem;
		font-size: clamp(0.95rem, 1.5vw, 1.15rem);
		line-height: 1.55;
		color: var(--ink-2);
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.cta-primary {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 2rem;
		background: var(--green);
		color: var(--sheet);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background 200ms var(--ease-out-expo), transform 120ms var(--ease-out-expo);
	}

	.cta-primary:hover { background: var(--green-deep); transform: translateY(-1px); }

	.cta-secondary {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 2rem;
		border: 1px solid var(--ink);
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background 200ms var(--ease-out-expo), color 200ms var(--ease-out-expo);
	}

	.cta-secondary:hover { background: var(--ink); color: var(--sheet); }

	.hero-data {
		display: flex;
		gap: clamp(1rem, 3vw, 2rem);
		padding-top: 0.6rem;
		border-top: 1px solid var(--line);
	}

	.hd {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.hd-val {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--ink);
	}

	/* placa */
	.hero-right {
		display: flex;
		justify-content: center;
	}

	.plate-frame {
		position: relative;
		border: 1px solid var(--line);
		background: var(--sheet);
		box-shadow:
			4px 4px 0 var(--line-soft),
			8px 8px 0 var(--line);
		padding: clamp(0.5rem, 1.2vw, 1rem);
		transition: transform 400ms var(--ease-out-expo), box-shadow 400ms var(--ease-out-expo);
	}

	.plate-frame:hover {
		transform: translateY(-4px);
		box-shadow:
			4px 8px 0 var(--line-soft),
			8px 16px 24px rgba(32,37,31,0.1);
	}

	.plate-svg {
		display: block;
		width: 100%;
		height: auto;
	}

	/* animación de curvas */
	.contour {
		stroke-dasharray: 800;
		stroke-dashoffset: 800;
		animation: draw-contour 2s var(--ease-out-expo) forwards;
	}
	.c1 { animation-delay: 0.2s; }
	.c2 { animation-delay: 0.35s; }
	.c3 { animation-delay: 0.5s; }
	.c4 { animation-delay: 0.65s; }
	.c5 { animation-delay: 0.8s; }
	.c6 { animation-delay: 0.95s; }

	@keyframes draw-contour {
		to { stroke-dashoffset: 0; }
	}

	.st-label {
		font-family: var(--font-mono);
		font-size: 8px;
		fill: var(--ink-3);
	}

	.north-label {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 9px;
		fill: var(--ink);
	}

	.scale-bar {
		font-family: var(--font-mono);
		font-size: 7px;
		fill: var(--ink-3);
	}

	.utm-ticks {
		font-family: var(--font-mono);
		font-size: 7px;
		fill: var(--ink-3);
		opacity: 0.7;
	}

	.measure-chip {
		position: absolute;
		bottom: -0.6rem;
		right: 0.8rem;
		background: var(--sheet);
		border: 1px solid var(--line);
		padding: 0.2rem 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: var(--ink-2);
		display: flex;
		gap: 0.5rem;
		white-space: nowrap;
		pointer-events: none;
	}

	.mc-sep { color: var(--line); }

	@media (max-width: 54rem) {
		.hero {
			height: auto;
			min-height: auto;
			max-height: none;
			padding-top: clamp(4.5rem, 16vw, 7rem);
			padding-bottom: clamp(3rem, 8vw, 5rem);
		}

		.hero-grid {
			grid-template-columns: 1fr;
			gap: clamp(2rem, 6vw, 3rem);
		}

		.hero-left {
			order: 1;
			text-align: left;
		}

		.hero-right {
			order: 0;
		}

		.plate-frame {
			max-width: 320px;
		}

		.corner { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hl { clip-path: inset(0 0 0 0); animation: none; }
		.contour { stroke-dashoffset: 0; animation: none; }
	}
</style>

<script>
	// Norte que apunta al cursor
	const plate = document.querySelector('.plate-frame') as HTMLElement | null;
	const needle = document.querySelector('#northNeedle') as SVGGElement | null;

	plate?.addEventListener('mousemove', (e) => {
		if (!needle || !plate) return;
		const rect = plate.getBoundingClientRect();
		const mx = (e.clientX - rect.left - rect.width / 2) / rect.width;
		const my = (e.clientY - rect.top - rect.height / 2) / rect.height;
		const angle = Math.atan2(mx, -my) * (180 / Math.PI);
		needle.setAttribute('transform', `translate(458,355) rotate(${angle})`);
	});

	// Coordenadas en chip
	const measureE = document.getElementById('measureE');
	const measureN = document.getElementById('measureN');
	const base = { e: 277165, n: 8676432 };

	plate?.addEventListener('mousemove', (e) => {
		if (!measureE || !measureN || !plate) return;
		const rect = plate.getBoundingClientRect();
		const x = (e.clientX - rect.left) / rect.width;
		const y = (e.clientY - rect.top) / rect.height;
		const eVal = Math.round(base.e + x * 110);
		const nVal = Math.round(base.n - y * 82);
		measureE.textContent = `E ${eVal.toLocaleString('es-PE')}`;
		measureN.textContent = `N ${nVal.toLocaleString('es-PE')}`;
	});

	// Parallax sutil en la placa
	plate?.addEventListener('mousemove', (e) => {
		if (!plate) return;
		const rect = plate.getBoundingClientRect();
		const x = ((e.clientX - rect.left) / rect.width - 0.5) * 6;
		const y = ((e.clientY - rect.top) / rect.height - 0.5) * 6;
		plate.style.transform = `translateY(-4px) translate(${x}px, ${y}px)`;
	});

	plate?.addEventListener('mouseleave', () => {
		if (plate) plate.style.transform = '';
	});
</script>
