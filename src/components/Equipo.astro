---
const team = [
	{ name: 'Arq. Moisés Sumari Jara', title: 'Arquitecto', role: 'CAP', id: '20636', initial: 'MS' },
	{ name: 'Ing. Civil Rubén Melo Laguna', title: 'Ingeniero Civil', role: 'CIP', id: '114010', initial: 'RM' },
	{ name: 'Ing. Electricista Nerbaldo N. Araujo', title: 'Ingeniero Electricista', role: 'CIP', id: '356625', initial: 'NN' },
	{ name: 'Ing. Sanitario Wilmer A. Pérez', title: 'Ingeniero Sanitario', role: 'CIP', id: '102980', initial: 'WP' },
];
---

<section class="equipo" id="equipo">
	<div class="container">
		<div class="rule-label">
			<span class="tag">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="2" width="12" height="12" stroke="currentColor" stroke-width="1.2" /><line x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 2" /><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 2" /></svg>
				CUADRO DE FIRMAS
			</span>
		</div>

		<div class="team-grid">
			{team.map((m) => (
				<div class="stamp">
					<div class="stamp-avatar">{m.initial}</div>
					<div class="stamp-info">
						<strong>{m.name}</strong>
						<span class="stamp-role">{m.title}</span>
						<span class="stamp-id">{m.role} Nº {m.id}</span>
					</div>
					<div class="stamp-sign">
						<svg viewBox="0 0 120 24" fill="none" aria-hidden="true" class="sig-svg">
							<path d="M4 18 C12 4, 28 4, 36 14 S52 20, 60 12 S76 2, 84 10 S100 18, 116 8" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" fill="none" />
						</svg>
						<span class="tag">FIRMA</span>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.equipo {
		padding: clamp(3rem, 8vw, 6rem) 0;
		background: var(--sheet);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.container {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2.5rem);
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(1rem, 2vw, 1.5rem);
	}

	.stamp {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: clamp(1rem, 2vw, 1.5rem);
		border: 1px solid var(--line);
		background: var(--paper);
		transition: border-color 200ms var(--ease-out-expo), box-shadow 200ms var(--ease-out-expo);
	}

	.stamp:hover {
		border-color: var(--green);
		box-shadow: 0 2px 16px rgba(30, 138, 76, 0.08);
	}

	.stamp-avatar {
		width: 2.5rem;
		height: 2.5rem;
		background: var(--green-wash);
		border: 1px solid var(--green);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--green-deep);
	}

	.stamp-info {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.stamp-info strong {
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.stamp-role {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--ink-3);
	}

	.stamp-id {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--green-deep);
	}

	.stamp-sign {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--line-soft);
	}

	.sig-svg {
		width: 100%;
		height: 20px;
	}

	@media (max-width: 54rem) {
		.team-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 30rem) {
		.team-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
