---
import "../styles/servicios.css";
import { categories } from "../data/servicios";
import ServiceCategory from "./servicios/ServiceCategory.astro";
---

<section class="servicios section" id="servicios">
  <div class="container">
    <div class="rule-label">
      <span class="tag">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="2" width="12" height="12" stroke="currentColor" stroke-width="1.2" /><line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 2" /></svg>
        INDICE DE PLANOS
      </span>
    </div>

    <div class="section-head">
      <h2 class="section-title">Indice de todos nuestros servicios</h2>
      <p class="section-sub">Obra, gestiones, estudios y especiales en un solo expediente.</p>
    </div>

    <div class="grid grid-cols-[repeat(2,1fr)] gap-[clamp(2rem,4vw,3rem)] max-[48rem]:grid-cols-1">
      {categories.map((cat) => <ServiceCategory category={cat} />)}
    </div>
  </div>
</section>
