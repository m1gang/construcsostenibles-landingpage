---
import { siteContact } from "../../data/site";
import { services } from "../../data/contacto";
---

<span class="tag form-head">Escríbenos</span>
<form
  id="contactForm"
  class="contact-form"
  data-wa={siteContact.waLink}
  novalidate
>
  <div class="form-row">
    <div class="field">
      <label class="tag" for="f-nombre">Nombre</label>
      <input
        id="f-nombre"
        name="nombre"
        type="text"
        placeholder="Su nombre"
        autocomplete="name"
        required
        minlength="2"
        maxlength="80"
        pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü\s.'-]{2,80}"
      />
    </div>
    <div class="field">
      <label class="tag" for="f-telefono">Teléfono</label>
      <input
        id="f-telefono"
        name="telefono"
        type="tel"
        placeholder="Ej.: 929 057 970"
        autocomplete="tel"
        required
        minlength="6"
        maxlength="20"
        inputmode="tel"
        pattern="(\+?51[\s.\-]?)?(9[0-9]{8}|(0[0-9]{2}|01)[\s.\-]?[0-9]{6,7}|[0-9]{6,7})"
        title="Celular: 9 dígitos que empiezan con 9 (Ej.: 929 057 970). Fijo Lima: 01 + 7 dígitos. Provincia: 0XX + 6 dígitos. Prefijo +51 opcional."
      />
      <small class="field-hint"
        >Celular 9XX XXX XXX o fijo con anexo (acepta +51).</small
      >
    </div>
  </div>
  <div class="field">
    <label class="tag" for="f-servicio">Servicio</label>
    <select id="f-servicio" name="servicio" required>
      {services.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>
  <div class="field">
    <label class="tag" for="f-mensaje">Detalle del proyecto</label>
      <textarea
        id="f-mensaje"
        name="mensaje"
        rows="3"
      placeholder="Ej.: Necesito planos firmados para licencia de construcción de una vivienda de 2 pisos…"
      required
      minlength="10"
      maxlength="1000"></textarea>
  </div>
  <!-- Honeypot anti-bots: los humanos no lo ven ni lo llenan -->
  <div class="hp-field" aria-hidden="true">
    <label for="f-empresa">Empresa</label>
    <input
      id="f-empresa"
      name="_honey"
      type="text"
      autocomplete="off"
      tabindex="-1"
    />
  </div>
  <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
  <button type="submit" class="form-submit" id="formSubmitBtn">
    <svg
      width="18"
      height="18"
      viewBox="0 0 20 20"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M10 1.8c-4.5 0-8.2 3.6-8.2 8.1 0 1.5.4 2.9 1.2 4.1L1.8 18.2l4.3-1.1c1.2.7 2.5 1 3.9 1 4.5 0 8.2-3.6 8.2-8.1S14.5 1.8 10 1.8z"
        stroke="currentColor"
        stroke-width="1.4"></path>
    </svg>
    <span id="formSubmitLabel">Enviar mensaje</span>
  </button>
</form>
<div class="form-alt">
  <span class="tag">O contáctanos directo:</span>
  <a
    href={siteContact.waLink}
    target="_blank"
    rel="noopener"
    class="wa-btn"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5L9.3 8.2c-.2-.5-.5-.4-.6-.4h-.5c-.2 0-.5.2-.7.3-.9.9-1.1 2.2-.2 3.9a11.6 11.6 0 0 0 4.5 4.2c1.7.8 2.4.9 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.3-.4z"
      ></path>
    </svg>
    Contáctanos por WhatsApp {siteContact.phoneShort}
  </a>
</div>
