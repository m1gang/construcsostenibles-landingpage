---
import Layout from "../layouts/Layout.astro";
import "../styles/page.css";
import Masthead from "../components/Masthead.astro";
import Hero from "../components/Hero.astro";
import Cinta from "../components/Cinta.astro";
import Servicios from "../components/Servicios.astro";
import Equipo from "../components/Equipo.astro";
import Proceso from "../components/Proceso.astro";
import Proyectos from "../components/Proyectos.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Planos de obra firmados en Perú | Construcciones Sostenibles">
  <!-- Cursor seguidor -->
  <div class="cursor-follower" id="cursorFollower" aria-hidden="true">
    <svg width="32" height="32" viewBox="0 0 32 32">
      <line
        x1="16"
        y1="0"
        x2="16"
        y2="12"
        stroke="var(--green)"
        stroke-width="0.8"></line>
      <line
        x1="16"
        y1="20"
        x2="16"
        y2="32"
        stroke="var(--green)"
        stroke-width="0.8"></line>
      <line
        x1="0"
        y1="16"
        x2="12"
        y2="16"
        stroke="var(--green)"
        stroke-width="0.8"></line>
      <line
        x1="20"
        y1="16"
        x2="32"
        y2="16"
        stroke="var(--green)"
        stroke-width="0.8"></line>
      <circle cx="16" cy="16" r="2" fill="var(--green)"></circle>
    </svg>
  </div>

  <!-- Barra de progreso -->
  <div class="progress-bar" id="progressBar" aria-hidden="true">
    <div class="progress-fill" id="progressFill"></div>
    <div class="progress-ticks">
      {
        [0, 25, 50, 75, 100].map((n) => (
          <span class="ptick" style={`left:${n}%`}>
            {n}
          </span>
        ))
      }
    </div>
  </div>

  <Masthead />
  <main>
    <Hero />
    <Cinta />
    <Servicios />
    <Equipo />
    <Proceso />
    <Proyectos />
    <Contacto />
  </main>
  <Footer />

  <script>
    import "../scripts/page";
  </script>
</Layout>
