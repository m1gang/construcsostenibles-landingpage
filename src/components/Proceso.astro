---
const steps = [
	{ pct: '30%', label: 'Inicio de contrato', desc: 'Arrancamos el proyecto con la firma del contrato y recopilación de información.' },
	{ pct: '20%', label: 'Anteproyecto', desc: 'Entrega de planos preliminares, memoria descriptiva y revisión con el cliente.' },
	{ pct: '50%', label: 'Finalización del trabajo', desc: 'Planos finales, firmados por el profesional correspondiente, listos para presentar.' },
];
---

<section class="proceso" id="proceso">
	<div class="container">
		<div class="rule-label">
			<span class="tag">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" /><polyline points="8,4 8,8 11,10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
				FORMA DE PAGO
			</span>
		</div>

		<div class="steps">
			{steps.map((s, i) => (
				<div class="step">
					<span class="step-pct">{s.pct}</span>
					<div class="step-body">
						<strong class="step-label">{s.label}</strong>
						<p class="step-desc">{s.desc}</p>
					</div>
					{i < steps.length - 1 && <div class="step-connector" aria-hidden="true">
						<svg width="100%" height="24" viewBox="0 0 200 24" preserveAspectRatio="none" fill="none">
							<path d="M0 12 H180 L172 6 M180 12 L172 18" stroke="var(--line)" stroke-width="1" stroke-linecap="round" />
						</svg>
					</div>}
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.proceso {
		padding: clamp(3rem, 8vw, 6rem) 0;
	}

	.container {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2.5rem);
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1rem, 2vw, 2rem);
	}

	.step {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: clamp(1rem, 2vw, 1.5rem);
		border: 1px solid var(--line);
		background: var(--sheet);
		position: relative;
		transition: border-color 200ms var(--ease-out-expo), transform 200ms var(--ease-out-expo);
	}

	.step:hover {
		border-color: var(--green);
		transform: translateY(-2px);
	}

	.step-pct {
		font-family: var(--font-mono);
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		font-weight: 700;
		color: var(--green);
		line-height: 1;
	}

	.step-label {
		font-size: 1rem;
		font-weight: 700;
		color: var(--ink);
	}

	.step-desc {
		font-size: 0.85rem;
		color: var(--ink-3);
		line-height: 1.5;
		margin: 0;
	}

	.step-connector {
		display: none;
	}

	@media (min-width: 48rem) {
		.step-connector {
			display: block;
			position: absolute;
			top: 50%;
			right: -2rem;
			transform: translateY(-50%);
			width: 2rem;
			overflow: visible;
		}

		.steps {
			grid-template-columns: 1fr 1fr 1fr;
		}
	}

	@media (max-width: 48rem) {
		.steps {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.step {
			border-bottom: none;
		}

		.step:last-child {
			border-bottom: 1px solid var(--line);
		}

		.step:not(:last-child)::after {
			content: '';
			display: block;
			border-bottom: 1px dashed var(--line);
			margin-top: 1rem;
		}
	}
</style>
