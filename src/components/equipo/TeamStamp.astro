---
import type { TeamMember } from "../../data/equipo";

interface Props {
  member: TeamMember;
}

const { member: m } = Astro.props;
// ID único por sello: el SVG usa textPath con referencia por id,
// y el id "sealPath" se duplicaría con 4 tarjetas en la página.
const sealPathId = `sealPath-${m.id}`;
---

<div class="stamp">
  <div class="stamp-figure" aria-hidden="true">
    <svg viewBox="0 0 160 104" fill="none" class="eng-svg">
      <line x1="80" y1="0" x2="80" y2="104" stroke="var(--line-soft)" stroke-width="0.8" stroke-dasharray="3 3" />
      <line x1="0" y1="52" x2="160" y2="52" stroke="var(--line-soft)" stroke-width="0.8" stroke-dasharray="3 3" />
      <path d="M22 104 C22 82 44 73 80 73 C116 73 138 82 138 104" fill="var(--green-wash)" stroke="var(--ink)" stroke-width="1.2" />
      <path d="M64 73 L73 88 L80 81 L87 88 L96 73" fill="none" stroke="var(--green-deep)" stroke-width="1.2" stroke-linejoin="round" />
      <path d="M30 96 L130 96" stroke="var(--green-deep)" stroke-width="1" stroke-dasharray="4 3" opacity="0.7" />
      <path d="M52 73 L58 88 M108 73 L102 88" stroke="var(--ink)" stroke-width="0.9" opacity="0.6" />
      <rect x="70" y="60" width="20" height="14" fill="var(--paper)" stroke="var(--ink)" stroke-width="1" />
      <ellipse cx="80" cy="49" rx="15" ry="14" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.2" />
      <path d="M53 42 C53 23 64 13 80 13 C96 13 107 23 107 42" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.2" />
      <rect x="76" y="8" width="8" height="10" rx="2" fill="var(--ink)" />
      <rect x="46" y="41" width="68" height="7" rx="3.5" fill="var(--ink)" />
      <line x1="60" y1="24" x2="60" y2="38" stroke="var(--line)" stroke-width="0.8" />
      <line x1="100" y1="24" x2="100" y2="38" stroke="var(--line)" stroke-width="0.8" />
      <circle cx="80" cy="49" r="1.4" fill="var(--ink)" opacity="0.5" />
    </svg>
    <span class="fig-tag tag">{m.role} · Nº {m.id}</span>
  </div>
  <div class="stamp-top">
    <div class="stamp-avatar">{m.initial}</div>
    <!-- Sello rotatorio -->
    <div class="seal">
      <svg viewBox="0 0 72 72" class="seal-svg">
        <circle cx="36" cy="36" r="30" fill="none" stroke="var(--green)" stroke-width="1" stroke-dasharray="3 2" />
        <circle cx="36" cy="36" r="24" fill="none" stroke="var(--green-deep)" stroke-width="0.8" />
        <text font-family="var(--font-mono)" font-size="6.5" font-weight="700" fill="var(--green-deep)">
          <textPath href={`#${sealPathId}`}>{m.role} · COLEGIADO · Nº {m.id} · COLEGIADO · </textPath>
        </text>
        <circle cx="36" cy="36" r="14" fill="none" stroke="var(--green)" stroke-width="0.6" />
        <text x="36" y="36" text-anchor="middle" dominant-baseline="central" font-family="var(--font-mono)" font-size="8" font-weight="700" fill="var(--green-deep)">{m.role}</text>
        <defs>
          <path id={sealPathId} d="M36,6 a30,30 0 1,1 0,60 a30,30 0 1,1 0,-60" />
        </defs>
      </svg>
    </div>
  </div>
  <div class="stamp-info">
    <strong>{m.name}</strong>
    <span class="stamp-title">{m.title}</span>
  </div>
  <div class="stamp-sign">
    <svg viewBox="0 0 120 22" fill="none" aria-hidden="true" class="sig-svg">
      <path d="M4 17 C12 3, 28 3, 36 13 S52 19, 60 11 S76 1, 84 9 S100 17, 116 7" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" fill="none" />
    </svg>
    <span class="tag">FIRMA</span>
  </div>
</div>
